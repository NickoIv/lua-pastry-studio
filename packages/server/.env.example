# Copy to packages/server/.env for local development.
# This server has no production deployment story — see docs/LOCAL-BACKEND.md.

# Defaults to the local dev cluster infra/db manages (port 54329, role
# app_server, trust auth — see infra/db/env.sh). Override only if you
# changed LUA_PG_PORT or are pointing at a different local cluster.
DATABASE_URL=postgres://app_server@127.0.0.1:54329/lua

# Bind address. 0.0.0.0 (the default) is required for a phone on the
# same Wi-Fi to reach this server — see docs/LOCAL-BACKEND.md
# "Cross-device testing". Use 127.0.0.1 to restrict to this machine only.
HOST=0.0.0.0
PORT=4000

# MUST be a real random secret before this server is reachable by
# anything other than your own machine's own processes. Generate one
# with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=lua-local-dev-secret-do-not-use-in-production

CORS_ORIGIN=*
