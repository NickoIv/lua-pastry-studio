# Lua Platform — environment template
# Copy to .env and fill in real values in each app's own environment.
# NOTHING in this file should ever contain a real secret. Frontend apps
# only ever receive PUBLIC values (Vite exposes VITE_* at build time) —
# privileged keys belong on the backend only, never in an app's env.

# Which data layer the apps should use. "mock" is the only supported
# value at this stage of the project — see packages/domain/src/mock.
# "http" is reserved for when a real backend adapter is implemented.
VITE_LUA_DATA_MODE=mock

# Placeholder for a future Supabase project. Anon keys are public by
# design (safe to ship in a frontend bundle when RLS is configured
# correctly) but no project is connected yet — leave blank.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# TTL (seconds) for guest-facing loyalty QR tokens. Must match the
# server-side value once a real token issuer exists. See
# packages/domain/src/qr for the abstraction this configures.
VITE_QR_TOKEN_TTL_SECONDS=90
