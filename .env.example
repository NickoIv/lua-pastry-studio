# Lua Platform — environment template
# Copy to .env and fill in real values in each app's own environment.
# NOTHING in this file should ever contain a real secret. Frontend apps
# only ever receive PUBLIC values (Vite exposes VITE_* at build time) —
# privileged keys belong on the backend only, never in an app's env.

# Which data layer the apps should use:
#   mock   — in-memory fixtures (packages/domain/src/mock), no backend needed
#   server — the real local backend (packages/server + Postgres) — see docs/LOCAL-BACKEND.md
VITE_LUA_DATA_MODE=mock

# Only used when VITE_LUA_DATA_MODE=server. Defaults to localhost, which
# only works from the same machine as the server. For a phone on the
# same Wi-Fi, set this to your Mac's LAN IP, e.g. http://192.168.1.23:4000/api
# — see docs/LOCAL-BACKEND.md "Cross-device testing".
VITE_LUA_API_URL=http://localhost:4000/api

# Placeholder for a possible future Supabase project (see
# docs/ARCHITECTURE.md §9) — not connected today; the real local backend
# is packages/server + a plain local Postgres. Leave blank.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Client-side fallback only when VITE_LUA_DATA_MODE=mock. In server mode
# the QR TTL is a real, Admin-editable database setting — see
# docs/ARCHITECTURE.md §16 — and this value is ignored.
VITE_QR_TOKEN_TTL_SECONDS=90
